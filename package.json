{
  "name": "bluehouse",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "poll": "bun apps/poller/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun drizzle/migrate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./constants": "./packages/shared/src/constants.ts",
    "./domain": "./packages/shared/src/domain.ts",
    "./format": "./packages/shared/src/format.ts",
    "./validators": "./packages/shared/src/validators.ts",
    "./db/schema": "./packages/shared/src/db/schema.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
